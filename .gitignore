# Environments
.venv/
venv/
ENV/
env/
*.env

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyc

# Testing, Coverage & Linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Distribution & Build Artifacts
build/
dist/
*.egg-info/
*.egg
*.spec.bak

# Model Weights (~4GB files - download automatically via app on first run)
models/*
!models/.gitkeep
*.safetensors
*.pt
*.pth
*.bin
*.onnx

# Static Binaries (>100MB exceeds GitHub standard push limit)
bin/*
!bin/.gitkeep

# Logs, Transcripts, and Subtitle Test Outputs
*.log
stt_transcription.txt
audio.wav
sample_output.*
output_*.srt
output_*.vtt

# Temporary Extraction & Audio Files
*.extracted.wav
*.tmp
tmp*

# IDE & OS Metadata
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db

